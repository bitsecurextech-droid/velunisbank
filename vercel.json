{
  "services": [
    {
      "name": "frontend",
      "root": "frontend",
      "framework": "nextjs",
      "routes": [{ "src": "/.*", "dest": "/" }]
    },
    {
      "name": "backend",
      "root": "backend",
      "type": "web",
      "buildCommand": "npm install && npx prisma generate && npm run build",
      "startCommand": "npm start",
      "routes": [{ "src": "/api/(.*)", "dest": "/api/$1" }]
    }
  ]
}
